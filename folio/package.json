    "@tanstack/react-start": "1.169.4",
    "aws4fetch": "1.0.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^4.10.38",
    "postal-mime": "2.7.6",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
