# Copy to .dev.vars for local development. Production values are set with `wrangler secret put`.
# 32 random bytes, base64. Wraps every practice's own data key. Never change it once real data exists.
MASTER_KEY=
# 32 random bytes, base64. Signs session and verification tokens.
SESSION_SECRET=
# Email sending: a Resend API key (preferred), or Amazon SES keys. Leave empty locally: mail is then printed to
# the console. MAIL_FROM's domain must be verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Anqulas Folio <no-reply@anqulas.com>
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Comma-separated emails allowed into /platform.
PLATFORM_ADMIN_EMAILS=
# Your UPI ID for plan payments, and the name payers see.
UPI_ID=
UPI_PAYEE_NAME=Anqulas
# Email import. INBOUND_DOMAIN: the domain of the forwarding addresses (Cloudflare Email Routing → folio-mail Worker).
# INBOX_TOKEN: 32+ random characters, the same value set on the folio-mail Worker.
INBOUND_DOMAIN=
INBOX_TOKEN=
